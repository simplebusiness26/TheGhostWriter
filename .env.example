# Free deterministic Ghost Writer foundation.
# No model-provider credential is required for the AI Factory bridge receiver.
GHOSTWRITER_MODE=demo

# AI Factory bridge receiver.
AI_FACTORY_URL=https://ai-factory.<your-cloudflare-subdomain>.workers.dev
AI_FACTORY_KEY=replace-with-the-same-secret-used-by-ai-factory

# Persistent local/server-side Journey Memory file.
GHOSTWRITER_MEMORY_PATH=data/ghost-writer-memory.json
