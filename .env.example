# Never commit real credentials. Keep them in the runtime environment only.
GHOSTWRITER_MODE=live
OPENAI_API_KEY=

# AI Factory bridge. These are enough to ingest queued evidence without using OpenAI.
AI_FACTORY_URL=
AI_FACTORY_KEY=

# Shared default model. Individual roles can be overridden below.
GHOSTWRITER_MODEL=gpt-5.6
GHOSTWRITER_RECORDER_MODEL=
GHOSTWRITER_STORY_MODEL=
GHOSTWRITER_WRITER_MODEL=
GHOSTWRITER_SECURITY_MODEL=

# Optional; defaults to the official OpenAI API endpoint.
GHOSTWRITER_OPENAI_BASE_URL=
