{
  "name": "the-ghost-writer",
  "version": "0.3.0",
  "private": true,
  "description": "Agent-first engine that turns real work into safe, human-approved content.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test && npm run cf:check",
    "bridge:pull": "npm run build && node scripts/pull-ai-factory.mjs",
    "cf:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
