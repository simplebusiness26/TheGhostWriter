{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghost-writer-receiver",
  "main": "src/os-entry.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AI_FACTORY_URL": "https://ai-factory.simplebussiness26.workers.dev"
  },
  "services": [
    {
      "binding": "AI_FACTORY",
      "service": "ai-factory"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
